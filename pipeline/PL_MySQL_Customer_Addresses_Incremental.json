							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "MySqlSource",
									"query": {
										"value": "@concat('SELECT''',activity('Lookup_Latest_Watermark').output.firstRow.latest_watermark,''' AS previous_watermark')",
